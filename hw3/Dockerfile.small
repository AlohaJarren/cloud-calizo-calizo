# Small runtime using Distroless Python 3
# Build Python deps on Debian (glibc), copy only site-packages, run on distroless.

# Stage 1: builder - install deps into a standalone site-packages dir
FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /w
COPY hw2/requirements.txt /w/requirements.txt

# Install all deps into /opt/site-packages (no venv needed)
RUN pip install --no-cache-dir -t /opt/site-packages -r /w/requirements.txt \
    # prune caches and tests (keep *.dist-info for importlib.metadata)
    && find /opt/site-packages -type d -name "__pycache__" -prune -exec rm -rf {} + \
    && find /opt/site-packages -type d -name "tests" -prune -exec rm -rf {} +

# Stage 2: runtime - distroless python3 (no shell, no package manager)
FROM gcr.io/distroless/python3-debian12:nonroot

# Make our copied packages importable
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/opt/site-packages

WORKDIR /app

# Copy only what we need to run
COPY --from=builder /opt/site-packages /opt/site-packages
COPY hw2/ /app/hw2/
COPY hw3/start.py /app/hw3/start.py

EXPOSE 5000

# Use exec-form and absolute python for healthcheck (distroless has no shell)
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
    CMD ["/usr/bin/python3", "-c", "import urllib.request as u; u.urlopen('http://127.0.0.1:5000/').read()"]

# Distroless entrypoint is already /usr/bin/python3
# So CMD must be only the script path.
CMD ["/app/hw3/start.py"]